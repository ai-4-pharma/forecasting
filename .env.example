# Assistente (chat com IA) via OpenRouter.
#
# Duas formas de ativar:
#   1. Copie este arquivo para ".env" (mesma pasta) e preencha a chave abaixo ANTES de rodar
#      a aplicação (ou depois: o arquivo é relido a cada mensagem).
#   2. Sem ".env": abra o Assistente na tela e cole a chave no campo. Ela fica só na memória
#      enquanto a aplicação estiver rodando.
#
# O ".env" está no .gitignore: nunca versione a sua chave.
# Crie a chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opcionais
# Modelo pré-selecionado (ID do OpenRouter; padrão: openai/gpt-4o-mini):
# OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
# Lista do seletor: IDs do OpenRouter separados por vírgula (preço e contexto vêm do catálogo):
# OPENROUTER_MODELS=openai/gpt-4o-mini,deepseek/deepseek-v4-flash,anthropic/claude-opus-5
# OPENROUTER_MAX_TOKENS=1500
# OPENROUTER_TIMEOUT=120
